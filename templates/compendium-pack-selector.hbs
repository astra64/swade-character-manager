<form class="cm-pack-selector-form" autocomplete="off">
  <div class="form-group">
    <label>Search Packs</label>
    <input type="text" data-pack-search placeholder="Search by name, ID, or module..." autofocus />
  </div>

  <div class="form-group cm-pack-selector-action-row">
    <button type="button" data-pack-reset-core-rules title="Check only SWADE Core Rules' packs, unchecking everything else">Reset to Core Rules Defaults</button>
    <button type="button" data-pack-clear-all title="Uncheck every pack — Character Manager will then auto-detect from every installed compendium instead">Clear All</button>
  </div>

  {{#if hasPacks}}
    <div class="form-group cm-pack-selector-scroll-panel">
      {{#each packs as |pack|}}
        <label class="cm-pack-selector-list-row cm-pack-selector-pack-row" data-pack-row data-pack-id="{{pack.id}}" data-search="{{pack.searchText}}">
          <span class="cm-pack-selector-row-main">
            <input type="checkbox" name="packs" value="{{pack.id}}" {{#if pack.selected}}checked{{/if}} />
            <div class="cm-pack-selector-info">
              <strong class="cm-pack-selector-row-title">{{pack.label}}</strong>
              <div class="cm-pack-selector-module">{{pack.moduleTitle}}{{#if pack.usedForLabel}} · {{pack.usedForLabel}}{{/if}}</div>
            </div>
            <span class="cm-pack-selector-row-meta">{{pack.id}}</span>
          </span>
        </label>
      {{/each}}
    </div>
  {{else}}
    <p>No Item compendiums are currently installed.</p>
  {{/if}}

  <p class="hint">Checked packs are scanned automatically for ancestry/skill/edge/hindrance/gear content. If nothing is checked, Character Manager uses every installed compendium instead. Hover a row to see its Pack ID.</p>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fas fa-save"></i>
      Save Selection
    </button>
  </footer>
</form>
