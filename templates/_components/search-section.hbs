<div class="form-group">
  <div class="search-input-row">
    <div class="search-container">
      <input type="text" class="search-input {{searchClass}}" placeholder="{{placeholder}}" autocomplete="off">
      <button type="button" class="btn-clear-search" data-action="{{clearAction}}" title="Clear search"></button>
      <div class="dropdown-menu {{dropdownClass}}"></div>
    </div>
    <button type="button" class="btn-add-ancestry btn-add-hindrance" data-action="{{addAction}}">Add</button>
    <button type="button" class="btn-open-compendium" data-action="{{browseAction}}">Browse</button>
  </div>
</div>
